# ── MIME types (modules JS Vite) ──
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
</IfModule>

# Évite qu'Apache devine une mauvaise ressource (cause fréquente de HTML à la place du .js)
Options -MultiViews

# ── Cache statique (assets versionnés par Vite) ──
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|webp|jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot|mp4|webm|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression gzip ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── SPA fallback (sauf fichiers statiques et API PHP) ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # API PHP : ne jamais rediriger vers index.html
  RewriteRule ^api/ - [L]

  # Fichiers statiques : ne jamais réécrire (évite MIME text/html sur les .js)
  RewriteRule \.(js|mjs|css|map|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico|mp4|webm|pdf|json)$ - [L,NC]

  # Routes React uniquement si le fichier/dossier n'existe pas
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
